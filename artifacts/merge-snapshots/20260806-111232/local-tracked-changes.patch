+  box-shadow: 0 16px 38px rgba(15, 23, 42, 0.08);
+}
+.skill-market-card.featured { min-height: 110px; }
+.skill-market-card-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+.skill-market-icon {
+  width: 28px;
+  height: 28px;
+  border-radius: 10px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex: none;
+  background: color-mix(in srgb, var(--skill-color, #3b82f6) 14%, #fff);
+  color: var(--skill-color, #3b82f6);
+  font-weight: 800;
+  font-size: 15px;
+}
+.skill-market-add {
+  width: 26px;
+  height: 26px;
+  border: 0;
+  border-radius: 8px;
+  background: #f1f2f1;
+  color: #1d2024;
+  cursor: pointer;
+  font-size: 18px;
+  line-height: 1;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+}
+.skill-market-add:hover:not(:disabled) { background: #e5e7e8; }
+.skill-market-add:disabled { opacity: 0.62; cursor: default; }
+.skill-market-card strong {
+  color: #111315;
+  font-size: 15px;
+  line-height: 1.3;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.skill-market-card p {
+  margin: 0;
+  color: #5f666d;
+  font-size: 13px;
+  line-height: 1.65;
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.skill-market-tabs {
+  display: flex;
+  align-items: center;
+  gap: 22px;
+  overflow-x: auto;
+  padding: 4px 0 14px;
+  margin-bottom: 4px;
+}
+.skill-market-tabs button {
+  border: 0;
+  background: transparent;
+  color: #8a8f94;
+  border-radius: 999px;
+  padding: 7px 12px;
+  cursor: pointer;
+  white-space: nowrap;
+  font-weight: 700;
+}
+.skill-market-tabs button.active {
+  background: #fff;
+  color: #121416;
+  box-shadow: 0 1px 6px rgba(15, 23, 42, 0.05);
+}
+.skill-market-package { margin-top: 10px; }
+.skill-market-package + .skill-market-package { margin-top: 18px; }
+.skill-market-package-head {
+  display: flex;
+  align-items: baseline;
+  gap: 10px;
+  margin: 0 0 10px;
+}
+.skill-market-package-head strong { font-size: 14px; color: #16191c; }
+.skill-market-package-head span {
+  font-size: 12px;
+  color: #8c9298;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.skill-create-dialog { max-width: 760px; }
+[data-theme='dark'] .skill-market-body { background: #16171a; }
+[data-theme='dark'] .skill-market-section-head h3, [data-theme='dark'] .skill-market-title-row h3,
+[data-theme='dark'] .skill-market-card strong, [data-theme='dark'] .skill-market-package-head strong { color: #eceef0; }
+[data-theme='dark'] .skill-market-card, [data-theme='dark'] .skill-market-tabs button.active { background: #202226; border-color: #2c2f34; }
+[data-theme='dark'] .skill-market-card p, [data-theme='dark'] .skill-market-title-row em, [data-theme='dark'] .skill-market-package-head span { color: #a7adb3; }
+[data-theme='dark'] .skill-market-add { background: #2b2e34; color: #eceef0; }
+@media (max-width: 980px) {
+  .skill-market-featured-grid, .skill-market-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+@media (max-width: 640px) {
+  .skill-market-body { padding: 18px 16px 32px; }
+  .skill-market-featured-grid, .skill-market-grid { grid-template-columns: 1fr; }
+  .skill-market-tabs { gap: 8px; }
+}
